# Copy to server/.env for local development (gitignored). See docs/configuration.md.
# In production these are set on the host (Coolify) or in the root .env that
# docker-compose.prod.yaml reads; variables marked REQUIRED use ${VAR:?} there, so a
# missing one fails loudly by name instead of booting with an empty credential.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://admin:quickstart@localhost:5432/quickstart

# The one origin browsers use. Dev: Vite (5173) proxies /trpc and /api/auth to :3000.
# Prod: nginx does the same on the public host. better-auth builds magic links from it,
# CORS allows it, Stripe returns to it. If it is wrong, login "works" and the cookie lands nowhere.
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# REQUIRED in production, 32+ chars. Rotating it signs everyone out.
AUTH_SECRET=
# true in production (no TLS locally). Parsed with z.stringbool: "false" means false.
COOKIE_SECURE=false

# smtp (Mailpit locally, any SMTP host) or loops (Loops.so transactional; needs both LOOPS_* ids).
# There is no fallback: the provider named here is the one that sends.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
LOOPS_API_KEY=
LOOPS_MAGIC_LINK_TEMPLATE_ID=
LOOPS_INVITATION_TEMPLATE_ID=
LOOPS_EMAIL_CHANGE_TEMPLATE_ID=
LOOPS_EMAIL_VERIFICATION_TEMPLATE_ID=
LOOPS_ACCOUNT_DELETION_TEMPLATE_ID=

# REQUIRED in production. Price ids are not secrets; the placeholder keeps dev booting.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_placeholder

# Optional: ERROR and CRITICAL rows are also posted here. See docs/error-reporting.md.
DISCORD_WEBHOOK_URL=
# Which upstream addresses may set X-Forwarded-For/Proto: a proxy-addr list (loopback,
# uniquelocal = private networks, i.e. the nginx container), a CIDR, or a hop count.
TRUST_PROXY=loopback,uniquelocal
LOG_LEVEL=debug
