{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/router/index.ts"
    },
    "./brand": {
      "types": "./src/config/brand.ts",
      "default": "./src/config/brand.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --import ./src/instrument.ts --watch src/index.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx --yes auth@1.7.5 generate --config src/auth/index.ts --output src/db/schema/auth.ts --yes",
    "make-admin": "node --env-file-if-exists=.env --import tsx src/scripts/make-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@sentry/node": "^10.75.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.1",
    "pino": "^10.3.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
