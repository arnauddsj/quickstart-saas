{
  "name": "quickstart-saas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter client typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --stream test",
    "test:integration": "pnpm --filter server test:integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:studio": "pnpm --filter server db:studio",
    "auth:schema": "pnpm --filter server auth:schema",
    "db:seed": "pnpm --filter server db:seed",
    "make-admin": "pnpm --filter server make-admin",
    "init-project": "pnpm --filter server init-project",
    "check-ready": "pnpm --filter server check-ready",
    "db:backup": "pnpm --filter server db:backup",
    "db:restore": "pnpm --filter server db:restore",
    "db:restore-check": "pnpm --filter server db:restore-check",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3"
  }
}
